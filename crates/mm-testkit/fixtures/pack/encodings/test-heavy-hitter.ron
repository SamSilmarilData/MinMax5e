// fixture: synthetic
// A heavy-weapon feat: hits made as part of the Attack action with a Heavy weapon deal
// extra damage equal to the proficiency bonus, and a crit offers one more attack with the
// same weapon as a Bonus Action, taken immediately after it. Whether the +PB reaches that
// attack too is the Ruling R-TST-HEW-BONUS; Heavy and the Attack action are tested first,
// so only the crit-gated attack reads it.
Feat((
    id: "2024:feat/test-heavy-hitter|tst",
    features: [
        (
            name: "Test Heavy Hitter",
            citation: (tier: Synthetic, reference: "research 03 §7.2, the heavy-weapon feat"),
            riders: [
                (
                    on: AttackHit,
                    when: Some(All([
                        Fact(WeaponProperty(Heavy)),
                        Any([
                            Fact(AttackAction),
                            Ruling("R-TST-HEW-BONUS", "bonus-action-too"),
                        ]),
                    ])),
                    effect: ProficiencyBonusDamage,
                ),
                (on: AttackCrit, optional: true, effect: BonusActionAttack),
            ],
        ),
    ],
))
